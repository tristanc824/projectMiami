# Public identifiers only. Never put client secrets, wallet keys, or API secrets here.
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_BUNDLE_IDENTIFIER=com.projectmiami.lazo
# Set this after linking your own Expo project with eas init.
EAS_PROJECT_ID=

# Live mode (real devnet USDC). Only works in a development/TestFlight build, never Expo Go or web.
# Privy dashboard: the app ID, and a client ID from Configuration > App settings > Clients.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
# HTTPS address of the deployed apps/api backend, e.g. https://your-app.vercel.app
EXPO_PUBLIC_DAT_API_URL=
