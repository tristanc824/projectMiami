import test, { mock } from 'node:test';
import assert from 'node:assert/strict';
import { Connection, Keypair, VersionedTransaction } from '@solana/web3.js';
import bs58 from 'bs58';
import nacl from 'tweetnacl';
import { buildTransferMessage } from '../lib/tx.mjs';
const payer = Keypair.generate(), sender = Keypair.generate();
process.env.FEE_PAYER_SECRET_KEY = JSON.stringify([...payer.secretKey]);
const { prepareTransfer, submitTransfer, USDC_MINT } = await import('../lib/server/solana.mjs');
let sends = 0, state: any = null, statusUnavailable = false;
mock.method(Connection.prototype, 'getGenesisHash', async () => 'EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG');
mock.method(Connection.prototype, 'getSignatureStatuses', async () => { if (statusUnavailable) throw new Error('RPC unavailable'); return { value: [state] }; });
mock.method(Connection.prototype, 'sendTransaction', async () => { sends++; return 'rpc-signature'; });
mock.method(Connection.prototype, 'confirmTransaction', async () => { throw new Error('Confirmation timed out'); });
test('uncertain confirmation retains the exact deterministic signature; later confirmation resolves without another send', async () => {
  const recipient = Keypair.generate().publicKey, blockhash = Keypair.generate().publicKey.toBase58();
  mock.method(Connection.prototype, 'getLatestBlockhash', async () => ({ blockhash, lastValidBlockHeight: 100 }));
  const message = buildTransferMessage({ feePayer: payer.publicKey, owner: sender.publicKey, recipient, mint: USDC_MINT, amount: 5_000_000n, blockhash });
  const bytes = message.serialize(), userSignature = nacl.sign.detached(bytes, sender.secretKey);
  const tx = new VersionedTransaction(message); tx.addSignature(sender.publicKey, userSignature); tx.sign([payer]);
  const expected = bs58.encode(tx.signatures[0]);
  assert.equal((await prepareTransfer(sender.publicKey, recipient, 5_000_000n)).transactionSignature, expected);
  const submit = () => submitTransfer(sender.publicKey, Buffer.from(bytes).toString('base64'), Buffer.from(userSignature).toString('base64'), 100);
  await assert.rejects(submit(), error => { assert.equal((error as any).code, 'TRANSACTION_PENDING'); assert.equal((error as any).signature, expected); return true; });
  assert.equal(sends, 1);
  statusUnavailable = true;
  await assert.rejects(submit(), (error: any) => error.code === 'TRANSACTION_PENDING' && error.signature === expected);
  assert.equal(sends, 1);
  statusUnavailable = false; state = { err: null, confirmationStatus: 'confirmed' };
  assert.equal(await submit(), expected); assert.equal(sends, 1);
  state = { err: { InstructionError: [0, 'InsufficientFunds'] }, confirmationStatus: 'confirmed' };
  await assert.rejects(submit(), (error: any) => error.code === 'TRANSACTION_FAILED');
  assert.equal(sends, 1);
  await assert.rejects(submitTransfer(sender.publicKey, Buffer.from(bytes).toString('base64'), Buffer.alloc(64).toString('base64'), 100), /Invalid wallet signature/);
});
