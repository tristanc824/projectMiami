# Copy to .env.local and fill in the values. Get them privately from the project owner, never through Git.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
TREASURY_SECRET_KEY=
