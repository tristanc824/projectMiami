# Family/voice review service. Keep the token on this server; never use EXPO_PUBLIC_*.
# Local: http://127.0.0.1:8000   Production: an HTTPS service URL.
REVIEW_API_URL=http://127.0.0.1:8000
REVIEW_API_TOKEN=
REVIEW_API_TIMEOUT_MS=180000
