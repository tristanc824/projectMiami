# Copy to .env.local and fill in the values. Get them privately from the project owner, never through Git.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
TREASURY_SECRET_KEY=
FEE_PAYER_SECRET_KEY=
# Devnet only. Use a dedicated provider's devnet HTTPS RPC for rehearsals.
# RPC URLs with provider keys are server secrets; never use EXPO_PUBLIC_ for them.
SOLANA_RPC_URL=https://api.devnet.solana.com
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Optional public marketing-site origin for the API landing page.
NEST_WEBSITE_URL=http://localhost:5175
# SMS idempotency/usage store: requires Node 24 and a persistent writable local disk.
# The laptop demo uses this ignored folder. Do not use ephemeral serverless storage for SMS payments.
SMS_STORE_PATH=.data/nest-sms.sqlite
# Text payments. Run `node scripts/setup-text-payments.mjs` to create and save the three PRIVY_ values.
PRIVY_AUTHORIZATION_KEY=
PRIVY_SIGNER_ID=
PRIVY_POLICY_ID=
# The demo Android's number (E.164, like +13055550199), and the httpSMS API key and webhook signing key.
TEXT_PAYMENTS_NUMBER=
HTTPSMS_API_KEY=
HTTPSMS_WEBHOOK_SIGNING_KEY=

# Family review server (python app.py at the repo root). Default http://127.0.0.1:8000. Token only if it listens on a network.
REVIEW_API_URL=
REVIEW_API_TOKEN=

# Whole-dollar test-card deposit cap; actual treasury funding must cover the deposit.
MAX_DEPOSIT_USD=1000
